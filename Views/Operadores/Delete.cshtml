@model MiniMES.Web.Models.Operador
@{
    ViewData["Title"] = "Excluir Operador";
}

<h1>Excluir Operador</h1>
<h3>Tem certeza?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>
        <dt class="col-sm-2">Matrícula</dt>
        <dd class="col-sm-10">@Model.Matricula</dd>
        <dt class="col-sm-2">Turno</dt>
        <dd class="col-sm-10">@Model.Turno?.Nome</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>