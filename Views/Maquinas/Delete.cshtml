@model MiniMES.Web.Models.Maquina
@{
    ViewData["Title"] = "Excluir Máquina";
}

<h1>Excluir Máquina</h1>
<h3>Tem certeza?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">@Model.Codigo</dd>
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>
        <dt class="col-sm-2">Linha</dt>
        <dd class="col-sm-10">@Model.LinhaProducao</dd>
        <dt class="col-sm-2">IP</dt>
        <dd class="col-sm-10">@Model.EnderecoIP</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>