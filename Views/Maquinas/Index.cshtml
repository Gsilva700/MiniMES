@model IEnumerable<MiniMES.Web.Models.Maquina>
@{
    ViewData["Title"] = "Máquinas";
}

<h1>Máquinas</h1>
@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
<p><a asp-action="Create" class="btn btn-primary">Nova Máquina</a></p>

<table class="table table-striped">
    <thead><tr><th>Código</th><th>Nome</th><th>Linha</th><th>IP</th><th>Ativa</th><th></th></tr></thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Codigo</td>
                <td>@m.Nome</td>
                <td>@m.LinhaProducao</td>
                <td>@m.EnderecoIP</td>
                <td>@(m.Ativa ? "Sim" : "Não")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>