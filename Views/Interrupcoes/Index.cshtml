@model IEnumerable<MiniMES.Web.Models.Interrupcao>
@{ ViewData["Title"] = "Interrupções"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Gerenciar Interrupções</h2>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">+ Nova Interrupção</a>
</div>

@if (TempData["Sucesso"] != null) { <div class="alert alert-success alert-dismissible fade show rounded-3">@TempData["Sucesso"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Descrição</th><th>Tipo</th><th>Status</th><th class="text-end">Ações</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.Descricao</td>
                <td><span class="badge bg-secondary rounded-pill px-3">@item.Tipo</span></td>
                <td>
                    @if(item.Ativa) { <span class="badge bg-success rounded-pill px-3">Ativa</span> } 
                    else { <span class="badge bg-danger rounded-pill px-3">Inativa</span> }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Excluir</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>