@model MiniMES.Web.Models.OrdemProducao
@{
    ViewData["Title"] = "Excluir Ordem";
}

<h1>Excluir Ordem</h1>
<h3>Tem certeza?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Número</dt>
        <dd class="col-sm-10">@Model.Numero</dd>
        <dt class="col-sm-2">Produto</dt>
        <dd class="col-sm-10">@Model.Produto</dd>
        <dt class="col-sm-2">Prev.</dt>
        <dd class="col-sm-10">@Model.QuantidadePrevista</dd>
        <dt class="col-sm-2">Máquina</dt>
        <dd class="col-sm-10">@Model.Maquina?.Nome</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>