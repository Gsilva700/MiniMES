@model IEnumerable<MiniMES.Web.Models.Turno>
@{
    ViewData["Title"] = "Turnos";
}

<h1>Turnos</h1>
@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
<p><a asp-action="Create" class="btn btn-primary">Novo Turno</a></p>

<table class="table table-striped">
    <thead><tr><th>Nome</th><th>Início</th><th>Fim</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.HoraInicio</td>
                <td>@item.HoraFim</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>