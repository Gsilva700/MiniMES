@model MiniMES.Web.Models.Turno
@{
    ViewData["Title"] = "Excluir Turno";
}

<h1>Excluir Turno</h1>
<h3>Tem certeza que deseja excluir?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>
        <dt class="col-sm-2">Início</dt>
        <dd class="col-sm-10">@Model.HoraInicio</dd>
        <dt class="col-sm-2">Fim</dt>
        <dd class="col-sm-10">@Model.HoraFim</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>