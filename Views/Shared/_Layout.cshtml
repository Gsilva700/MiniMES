<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini-MES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">📦 Mini-MES</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Turnos" asp-action="Index">Turnos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Operadores" asp-action="Index">Operadores</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Maquinas" asp-action="Index">Máquinas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Interrupcoes" asp-action="Index">Interrupções</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="OrdensProducao" asp-action="Index">Ordens</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Apontamentos" asp-action="Index">Apontamentos</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- O flex-grow-1 empurra o footer para o final da tela -->
    <div class="container flex-grow-1 px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3">
        <div class="container text-center">
            &copy; 2026 - MiniMES - Desenvolvido por <strong>Gabriel Silva</strong> |
            <a href="https://github.com/Gsilva700" target="_blank" class="text-decoration-none">GitHub</a> | 
            <a href="https://www.linkedin.com/in/gabriel-de-macedo/" target="_blank" class="text-decoration-none">LinkedIn</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>